          "Corpus"
        ],
        "summary": "Zadania jednej formy: numer, pula punktów, rodzaj, czy ma rysunek",
        "operationId": "ListFormTasks",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
