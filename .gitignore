# --- dane: mirror, blob, raporty ---
# Wykluczamy ZAWARTOŚĆ katalogu (data/*), nie sam katalog (data/).
# Git nie zagląda do wykluczonego katalogu, więc po `data/` żadne `!data/...`
# już nie działa — wyjątki muszą wisieć przy wzorcu z gwiazdką.
data/*
!data/.gitkeep
!data/blob/
data/blob/*
!data/blob/.gitkeep
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/reports/
data/reports/*
!data/reports/.gitkeep
!data/inventory/
data/inventory/*
!data/inventory/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- .NET ---
bin/
obj/
*.user
*.suo
.vs/
TestResults/

# --- Node ---
node_modules/
dist/
.vite/
*.tsbuildinfo
.turbo/

# --- środowisko ---
.env
.env.local
*.local

# --- IDE / OS ---
.idea/
.DS_Store
Thumbs.db

# --- generowane, ale WERSJONOWANE (celowo nie ignorowane) ---
# web/packages/api-client/src/schema.d.ts  — dryf kontraktu ma łamać build
# ingest/tests/fixtures/                   — utrwalone wyjścia warstwy pozycyjnej
